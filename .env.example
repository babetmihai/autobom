# ===========================================
# General
# ===========================================
VITE_APP_VERSION=v5
TRELLIS_URL=http://localhost:5000
IMAGE_ANALYZER_URL=http://localhost:5001
SCENE_ANALYZER_URL=http://localhost:5004
EMBEDDING_ANALYZER_URL=http://localhost:5005
TEXT_ANALYZER_URL=http://localhost:5003
COLADA_URL=http://localhost:5002
AUTOBOM_HTML_DIALOG_URL=http://localhost:5173

# Comma-separated ticker workers. Empty = start none.
# product_scraper,product_analyzer,trellis_converter,colada_converter,scene_crops,scene_embeddings
# Analysis, GLB, COLADA, scene crops, and scene matching only run when the UI sets status.* PENDING.
# npm run server:up starts matching docker stacks then the ticker server
SERVICES_ENABLED=product_scraper

# Unique per machine (defaults to hostname). Used for job claims across boxes.
# MACHINE_ID=gpu-box-1

# Idle catch-up interval when no wake arrives, seconds
WAKE_CATCHUP_SECONDS=120

# Reclaim PROCESSING locks older than this (ms). Default 2h.
# LOCK_STALE_MS=7200000

# ===========================================
# Firebase (paths relative to repo root — see README)
# ===========================================
FIREBASE_CONFIG=firebaseConfig.json
FIREBASE_SERVICE_ACCOUNT=

# ===========================================
# Trellis container (4090 Mobile 16GB — OOM expected)
# Process quality params live in server/lib/trellis.ts PROCESS_PARAMS
# ===========================================
TRELLIS_LOW_VRAM=true

# ===========================================
# Image analyzer container (image tags + color)
# Start: npm run image-analyzer:docker
# ===========================================
# IMAGE_ANALYZER_URL=http://localhost:5001
# IMAGE_ANALYZER_TAGS=chair,sofa,table,metallic,wood
# IMAGE_ANALYZER_TAG_THRESHOLD=0.22

# ===========================================
# Text analyzer container (LLM tags + dimensions)
# Start: docker compose -f services/text_analyzer/docker-compose.yml up -d
# Pull model once: docker exec text-analyzer-ollama ollama pull llama3.2:3b
# ===========================================
# TEXT_ANALYZER_URL=http://localhost:5003
# OLLAMA_MODEL=llama3.2:3b
# Also exposes POST /extract-product { url } for store page scraping
# Product scrape: status.scrape PENDING → extract → COMPLETED

# ===========================================
# Colada container (GLB → COLLADA zip with textures)
# ===========================================
# COLADA_URL=http://localhost:5002

# ===========================================
# Scene analyzer container (furniture detect + crop)
# Start: npm run scene-analyzer:docker
# ===========================================
# SCENE_ANALYZER_URL=http://localhost:5004

# ===========================================
# Embedding analyzer container (CLIP vectors)
# Start: npm run embedding-analyzer:docker
# Ticker: npm run server
# ===========================================
# EMBEDDING_ANALYZER_URL=http://localhost:5005

# ===========================================
# Scene analyzer UI: npm run dev — Catalog at /#/ — Scene Analyzer at /#/scene-analyzer
# ===========================================
