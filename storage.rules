rules_version = '2'

service firebase.storage {
  match /b/{bucket}/o {
    match /images/{fileName} {
      allow read: if request.auth != null
      allow write: if request.auth != null
    }

    match /scenes/{allPaths=**} {
      allow read: if request.auth != null
      allow write: if request.auth != null
    }

    match /models/{allPaths=**} {
      allow read: if request.auth != null
      allow write: if false
    }
  }
}
